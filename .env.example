# First launch works without an API key.
DEMO_MODE=true
AUTO_SUBMIT=false
CLOUD_DEPLOYMENT=false

# Optional real AI features. Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local-only paths. Relative paths are resolved from the project directory.
AI_JOB_AGENT_DB=data/ai_job_agent.db
AI_JOB_AGENT_UPLOADS=uploads
AI_JOB_AGENT_LOGS=logs

# Required before using run-lan.ps1. Use at least 12 random characters.
APP_ACCESS_PASSWORD=
